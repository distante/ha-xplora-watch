# artifacts
__pycache__
.pytest*
*.egg-info
*/build/*
*/dist/*


# misc
.coverage
coverage.xml
coverage.json
.ruff_cache
.DS_Store

# VS Code - exclude personal settings but include project settings
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
.vscode/settings.local.json

# Claude Code - machine-specific settings (absolute paths differ per environment)
.claude/settings.local.json


# Home Assistant configuration
config/*
!config/configuration.yaml
!config/.HA_VERSION

node_modules

# Browser e2e (Playwright): the throwaway demo HA config dir + auth state, and the run reports.
# We commit the recipe (tests/e2e/), never the regenerated runtime state — same split as config/.
.e2e-ha/
test-results/
playwright-report/
blob-report/

# NOTE: custom_components/xplora_watch/services.yaml is committed (a static description of every
# service) because hassfest/HACS require it. The integration overwrites it locally at runtime with
# per-watch target/user dropdown options (helper.create_service_yaml_file) -- don't commit those
# local, account-specific changes.
