# Home Assistant configuration
config/*
!config/configuration.yaml
!config/.HA_VERSION

node_modules

# helper.create_service_yaml_file() overwrites this in-place with real account data (watch ids,
# usernames) every time the integration starts. Never commit; create_service_yaml_file() regenerates
# it on first run if missing.
custom_components/xplora_watch/services.yaml
